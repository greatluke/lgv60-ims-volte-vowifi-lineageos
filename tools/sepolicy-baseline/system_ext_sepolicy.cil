;;* lmx 32 device/qcom/sepolicy/generic/public/property.te
(neverallow base_typeattr_232 vendor_bt_prop (property_service (set)))
;;* lme
;;* lmx 35 device/qcom/sepolicy/generic/public/property.te
(neverallow base_typeattr_232 vendor_wlc_prop (property_service (set)))
;;* lme
;;* lmx 39 device/qcom/sepolicy/generic/public/property.te
(allow vendor_init vendor_afp_prop (property_service (set)))
;;* lme
;;* lmx 39 device/qcom/sepolicy/generic/public/property.te
(allow vendor_init vendor_afp_prop (file (read getattr map open)))
;;* lme
;;* lmx 39 device/qcom/sepolicy/generic/public/property.te
(neverallow base_typeattr_233 vendor_afp_prop (property_service (set)))
;;* lme
